write_tsv<-function(x,path)write.table(x,path,sep="\t",row.names=FALSE,col.names=TRUE,quote=FALSE,fileEncoding="UTF-8")
desc_stats<-function(x){x<-x[is.finite(x)];if(!length(x))return(data.frame(n=0,mean=NA,sd=NA,median=NA,q1=NA,q3=NA,min=NA,max=NA));data.frame(n=length(x),mean=mean(x),sd=if(length(x)>1)sd(x)else 0,median=median(x),q1=unname(quantile(x,.25)),q3=unname(quantile(x,.75)),min=min(x),max=max(x))}
mean_or_na<-function(x)if(all(is.na(x)))NA_real_ else mean(x,na.rm=TRUE)
fmt_p<-function(p)ifelse(is.na(p),"P unavailable",ifelse(p<.001,"P < 0.001",paste0("P = ",sprintf("%.3f",p))))
pal<-c("#6F4C9F","#D56C9C","#7B8CCB","#B68ACD","#F59B5E","#F6D55C","#9E9E9E","#338333")
font_family<-"Arial"
theme_journal<-function(base_size=12)theme_classic(base_size=base_size,base_family=font_family)+theme(text=element_text(colour="#222222"),plot.title=element_text(face="bold",size=base_size+2),plot.subtitle=element_text(colour="#555555",margin=margin(b=8)),plot.caption=element_text(colour="#555555",size=base_size-2,hjust=0,margin=margin(t=8)),axis.title=element_text(face="bold"),legend.title=element_text(face="bold"),legend.position="top",panel.grid.major.y=element_line(colour="#E6E6E6",linewidth=.3),panel.grid.minor=element_blank(),plot.margin=margin(10,14,10,10))
save_figure<-function(p,stem,width,height){
  if(!is.null(p$labels$subtitle)&&is.character(p$labels$subtitle))p<-p+labs(subtitle=paste(strwrap(p$labels$subtitle,width=78),collapse="\n"))
  if(!is.null(p$labels$caption)&&is.character(p$labels$caption))p<-p+labs(caption=paste(strwrap(p$labels$caption,width=105),collapse="\n"))
  p<-p+theme(plot.caption.position="plot",plot.caption=element_text(lineheight=.95))
  saveRDS(p,file.path(script_dir,paste0(stem,".plot.rds")))
  ggsave(file.path(script_dir,paste0(stem,".pdf")),p,device=grDevices::cairo_pdf,width=width,height=height,units="in",bg="white")
  ggsave(file.path(script_dir,paste0(stem,".png")),p,device="png",dpi=600,width=width,height=height,units="in",bg="white")
}

eligible_unique<-model_dat |> filter(primary_eligible==1) |> distinct(article_no,table2_row,.keep_all=TRUE)
counts<-eligible_unique |> group_by(table2_row,canonical_model_en) |> summarise(article_count=n_distinct(article_no),submission_n=sum(is.finite(lag_submission_days)),.groups="drop") |> filter(submission_n>=5) |> slice_max(article_count,n=20,with_ties=FALSE)
plot_dat<-eligible_unique |> inner_join(counts,by=c("table2_row","canonical_model_en")) |> filter(is.finite(lag_submission_days))
summary_dat<-plot_dat |> group_by(canonical_model_en,article_count) |> group_modify(~desc_stats(.x$lag_submission_days)) |> ungroup() |> mutate(canonical_model_en=fct_reorder(canonical_model_en,median))
write_tsv(plot_dat,file.path(script_dir,"fig 3b analysis data used.txt")); write_tsv(summary_dat,file.path(script_dir,"fig 3b model summary.txt"))
p<-ggplot(summary_dat,aes(canonical_model_en,median,colour=median,size=article_count))+geom_errorbar(aes(ymin=q1,ymax=q3),width=.18,linewidth=.65,colour=pal[7])+geom_point(alpha=.96)+coord_flip()+geom_hline(yintercept=0,linetype=2,colour=pal[7])+scale_colour_gradientn(colours=pal[c(1,4,2,5,6)])+scale_size(range=c(2.6,7.2))+labs(title="Submission lag for frequently studied models",subtitle="Median and interquartile range; at least five articles",x=NULL,y="Model-level submission lag (days)",colour="Median",size="Articles")+theme_journal()+theme(panel.grid.major.y=element_blank())
label_x<-max(summary_dat$q3,na.rm=TRUE)+.08*diff(range(c(summary_dat$q1,summary_dat$q3),na.rm=TRUE));p<-p+geom_text(data=transform(summary_dat,label_x=label_x),show.legend=FALSE,aes(y=label_x,label=paste0(round(median)," d; n=",article_count)),hjust=0,family=font_family,size=2.35)+coord_flip(clip="off")+scale_y_continuous(limits=c(min(0,min(summary_dat$q1,na.rm=TRUE)),label_x*1.18))+labs(caption=paste0("Values are based on one observation per article-model pair; models shown = ",nrow(summary_dat),"."))+theme(plot.margin=margin(10,75,10,10))
