write_tsv<-function(x,path)write.table(x,path,sep="\t",row.names=FALSE,col.names=TRUE,quote=FALSE,fileEncoding="UTF-8")
desc_stats<-function(x){x<-x[is.finite(x)];if(!length(x))return(data.frame(n=0,mean=NA,sd=NA,median=NA,q1=NA,q3=NA,min=NA,max=NA));data.frame(n=length(x),mean=mean(x),sd=if(length(x)>1)sd(x)else 0,median=median(x),q1=unname(quantile(x,.25)),q3=unname(quantile(x,.75)),min=min(x),max=max(x))}
mean_or_na<-function(x)if(all(is.na(x)))NA_real_ else mean(x,na.rm=TRUE)
fmt_p<-function(p)ifelse(is.na(p),"P unavailable",ifelse(p<.001,"P < 0.001",paste0("P = ",sprintf("%.3f",p))))
pal<-c("#6F4C9F","#D56C9C","#7B8CCB","#B68ACD","#F59B5E","#F6D55C","#9E9E9E","#338333")
font_family<-"Arial"
theme_journal<-function(base_size=12)theme_classic(base_size=base_size,base_family=font_family)+theme(text=element_text(colour="#222222"),plot.title=element_text(face="bold",size=base_size+2),plot.subtitle=element_text(colour="#555555",margin=margin(b=8)),plot.caption=element_text(colour="#555555",size=base_size-2,hjust=0,margin=margin(t=8)),axis.title=element_text(face="bold"),legend.title=element_text(face="bold"),legend.position="top",panel.grid.major.y=element_line(colour="#E6E6E6",linewidth=.3),panel.grid.minor=element_blank(),plot.margin=margin(10,14,10,10))
save_figure<-function(p,stem,width,height){
  if(!is.null(p$labels$subtitle)&&is.character(p$labels$subtitle))p<-p+labs(subtitle=paste(strwrap(p$labels$subtitle,width=78),collapse="\n"))
  if(!is.null(p$labels$caption)&&is.character(p$labels$caption))p<-p+labs(caption=paste(strwrap(p$labels$caption,width=105),collapse="\n"))
  p<-p+theme(plot.caption.position="plot",plot.caption=element_text(lineheight=.95))
  saveRDS(p,file.path(script_dir,paste0(stem,".plot.rds")))
  ggsave(file.path(script_dir,paste0(stem,".pdf")),p,device=grDevices::cairo_pdf,width=width,height=height,units="in",bg="white")
  ggsave(file.path(script_dir,paste0(stem,".png")),p,device="png",dpi=600,width=width,height=height,units="in",bg="white")
}

eligible <- article_dat |> filter(!is.na(department_en), nzchar(department_en), is.finite(lag_submission_mean_days))
top <- eligible |> count(department_en, sort=TRUE) |> slice_head(n=12) |> pull(department_en)
plot_dat <- eligible |> mutate(group=if_else(department_en %in% top, department_en, "Other specialties"), group=fct_reorder(group,lag_submission_mean_days,median))
kw<-kruskal.test(lag_submission_mean_days~group,data=plot_dat); k<-n_distinct(plot_dat$group); eps2<-max(0,(unname(kw$statistic)-k+1)/(nrow(plot_dat)-k))
summary_dat<-plot_dat |> group_by(group) |> group_modify(~desc_stats(.x$lag_submission_mean_days)) |> ungroup()
write_tsv(plot_dat,file.path(script_dir,"fig 2a analysis data used.txt")); writeLines(c("Primary top-12-plus-Other Kruskal-Wallis test",paste0("All eligible articles retained: n = ",nrow(plot_dat)),paste0("H = ",sprintf("%.4f",unname(kw$statistic))),paste0("df = ",unname(kw$parameter)),paste0("P = ",format.pval(kw$p.value,digits=4)),paste0("Epsilon-squared = ",sprintf("%.4f",eps2))),file.path(script_dir,"fig 2a statistical results.txt"))
group_cols<-setNames(rep(pal,length.out=n_distinct(plot_dat$group)),levels(plot_dat$group))
p<-ggplot(plot_dat,aes(group,lag_submission_mean_days,fill=group))+geom_boxplot(outlier.shape=NA,alpha=.76,colour="#303030",linewidth=.55)+geom_jitter(aes(colour=group),width=.14,alpha=.58,size=1.7,show.legend=FALSE)+coord_flip()+geom_hline(yintercept=0,linetype=2,colour=pal[7])+scale_fill_manual(values=group_cols)+scale_colour_manual(values=group_cols)+labs(title="Submission lag across clinical specialties",subtitle="Twelve most frequent specialties plus Other; all eligible articles retained",x=NULL,y="Article-level mean lag (days)")+theme_journal()+theme(legend.position="none",panel.grid.major.y=element_blank())
label_dat<-summary_dat|>transmute(group,axis_label=paste0(group,"\nMedian ",round(median)," d; n=",n));p<-p+scale_x_discrete(labels=setNames(label_dat$axis_label,label_dat$group))+labs(caption=paste0("Primary omnibus test: Kruskal-Wallis ",fmt_p(kw$p.value),"; epsilon-squared = ",sprintf("%.2f",eps2),"; n = ",nrow(plot_dat)))+theme(axis.text.y=element_text(size=8.5,lineheight=.95))
save_figure(p,"Figure 2 A Submission lag by clinical specialty",11.2,7.7); write_tsv(summary_dat,file.path(script_dir,"fig 2a group summary.txt"))
