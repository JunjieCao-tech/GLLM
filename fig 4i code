  filter(primary_eligible==1,is.finite(lag_submission_days),nzchar(model))|>
  distinct(article_no,model,.keep_all=TRUE)|>
  select(article_no,model,lag_submission_days)

prob_stats<-function(a,b){
  dif<-outer(a$lag_submission_days,b$lag_submission_days,"-")
  n_pairs<-length(dif);pa<-sum(dif>0)/n_pairs;pb<-sum(dif<0)/n_pairs;pt<-sum(dif==0)/n_pairs
  c(a_longer=pa,b_longer=pb,tie=pt,delta=pa-pb,pairs=n_pairs)
}
cluster_boot<-function(a,b,B=1000,seed=1){
  ids<-sort(unique(c(a$article_no,b$article_no)));set.seed(seed)
  ans<-matrix(NA_real_,B,2,dimnames=list(NULL,c("a_longer","delta")))
  for(i in seq_len(B)){
    tab<-table(sample(ids,length(ids),replace=TRUE));wa<-tab[as.character(a$article_no)];wb<-tab[as.character(b$article_no)];wa[is.na(wa)]<-0;wb[is.na(wb)]<-0
    xa<-rep(a$lag_submission_days,as.integer(wa));xb<-rep(b$lag_submission_days,as.integer(wb));if(!length(xa)||!length(xb))next
    dif<-outer(xa,xb,"-");pa<-mean(dif>0);pb<-mean(dif<0);ans[i,]<-c(pa,pa-pb)
  }
  c(a_low=unname(quantile(ans[,1],.025,na.rm=TRUE)),a_high=unname(quantile(ans[,1],.975,na.rm=TRUE)),delta_low=unname(quantile(ans[,2],.025,na.rm=TRUE)),delta_high=unname(quantile(ans[,2],.975,na.rm=TRUE)))
}
pair_table<-function(min_articles,bootstrap=FALSE,B=1000){
  keep<-d|>count(model,name="n")|>filter(n>=min_articles)|>pull(model);pairs<-combn(keep,2,simplify=FALSE)
  out<-bind_rows(lapply(seq_along(pairs),function(i){
    z<-pairs[[i]];a<-d|>filter(model==z[1]);b<-d|>filter(model==z[2]);s<-prob_stats(a,b);mw<-suppressWarnings(wilcox.test(a$lag_submission_days,b$lag_submission_days,exact=FALSE))
    ci<-if(bootstrap)cluster_boot(a,b,B=B,seed=20261018+i) else c(a_low=NA,a_high=NA,delta_low=NA,delta_high=NA)
    data.frame(model_a=z[1],model_b=z[2],n_a=nrow(a),n_b=nrow(b),overlap_articles=length(intersect(a$article_no,b$article_no)),cross_article_pairs=s[["pairs"]],model_a_longer_pct=100*s[["a_longer"]],model_b_longer_pct=100*s[["b_longer"]],tie_pct=100*s[["tie"]],cliffs_delta=s[["delta"]],a_longer_ci_low=100*ci[["a_low"]],a_longer_ci_high=100*ci[["a_high"]],cliffs_delta_ci_low=ci[["delta_low"]],cliffs_delta_ci_high=ci[["delta_high"]],mann_whitney_p=mw$p.value)
  }))
  out|>mutate(mann_whitney_p_BH=p.adjust(mann_whitney_p,"BH"),min_model_n=pmin(n_a,n_b),analysis=ifelse(bootstrap,"Primary: each model in >=10 articles; 1000 article-cluster bootstrap replicates","Exploratory: each model in >=5 articles; descriptive estimates"))
}

primary_path<-file.path(script_dir,"fig 3i primary model-pair summary with cluster-bootstrap CI.txt")
