if(use_cache){primary<-read_tsv(primary_path);exploratory<-read_tsv(exploratory_path)}else{
  primary<-pair_table(10,bootstrap=TRUE,B=1000);exploratory<-pair_table(5,bootstrap=FALSE)
  write_tsv(primary,primary_path);write_tsv(exploratory,exploratory_path)
}
