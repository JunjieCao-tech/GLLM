}

d<-pre|>mutate(model_set_change_type=recode(model_set_change_type,"Reported change: direction unspecified"="Direction unspecified","Reported change; direction unspecified"="Direction unspecified"))|>count(model_set_change_type,name="n")|>filter(!is.na(model_set_change_type),nzchar(model_set_change_type))|>
 mutate(pct=n/sum(n))|>arrange(desc(n))|>mutate(model_set_change_type=factor(model_set_change_type,levels=rev(model_set_change_type)))
dots<-d|>rowwise()|>do(data.frame(model_set_change_type=.$model_set_change_type,idx=seq_len(.$n)))|>ungroup()|>
 group_by(model_set_change_type)|>mutate(col=(row_number()-1)%%30,row=floor((row_number()-1)/30))|>ungroup()
display_order<-c("Direction unspecified","Removals only","Additions only","Additions and removals","Unchanged")
category_base<-setNames(rev(seq_along(display_order)),display_order)
dots<-dots|>mutate(y_base=unname(category_base[as.character(model_set_change_type)]),plot_y=y_base-row*.27)
