get_script_dir<-function(){
 override<-Sys.getenv("LLM_LAG_SCRIPT_DIR",unset="")
 if(nzchar(override))return(normalizePath(override,mustWork=TRUE))
 args<-commandArgs(trailingOnly=FALSE);f<-grep("^--file=",args,value=TRUE)
 if(length(f))return(dirname(normalizePath(sub("^--file=","",f[1]))))
 if(requireNamespace("rstudioapi",quietly=TRUE)&&rstudioapi::isAvailable()){p<-rstudioapi::getActiveDocumentContext()$path;if(nzchar(p))return(dirname(normalizePath(p)))}
 normalizePath(getwd())
}
script_dir<-get_script_dir();project_dir<-normalizePath(file.path(script_dir,".."),mustWork=TRUE)
read_tsv<-function(p){
 if(!file.exists(p))stop("Missing input: ",p)
 for(enc in c("UTF-8","UTF-8-BOM","GB18030","GBK")){
  lines<-tryCatch(readLines(p,encoding=enc,warn=FALSE),error=function(e)NULL)
  if(is.null(lines)||length(lines)<2)next
  x<-tryCatch(read.delim(textConnection(lines),sep="\t",header=TRUE,quote="",fill=TRUE,comment.char="",stringsAsFactors=FALSE,check.names=FALSE,na.strings=c("","NA","N/A")),error=function(e)NULL)
  if(!is.null(x)&&nrow(x)>0)return(x)
 }
 stop("Cannot read: ",p)
}
