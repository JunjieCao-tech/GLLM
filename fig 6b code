required_packages<-c("ggplot2","dplyr","tidyr","scales")
missing_packages<-required_packages[!vapply(required_packages,requireNamespace,logical(1),quietly=TRUE)]
if(length(missing_packages)>0)install.packages(missing_packages,repos="https://cloud.r-project.org",dependencies=TRUE)
suppressPackageStartupMessages({library(ggplot2);library(dplyr);library(tidyr);library(scales)})
get_script_dir<-function(){
 override<-Sys.getenv("LLM_LAG_SCRIPT_DIR",unset="")
 if(nzchar(override))return(normalizePath(override,mustWork=TRUE))
 args<-commandArgs(trailingOnly=FALSE);f<-grep("^--file=",args,value=TRUE)
 if(length(f))return(dirname(normalizePath(sub("^--file=","",f[1]))))
 if(requireNamespace("rstudioapi",quietly=TRUE)&&rstudioapi::isAvailable()){p<-rstudioapi::getActiveDocumentContext()$path;if(nzchar(p))return(dirname(normalizePath(p)))}
 normalizePath(getwd())
}
script_dir<-get_script_dir();project_dir<-normalizePath(file.path(script_dir,".."),mustWork=TRUE)
read_tsv<-function(p){
 if(!file.exists(p))stop("Missing input: ",p)
 for(enc in c("UTF-8","UTF-8-BOM","GB18030","GBK")){
  lines<-tryCatch(readLines(p,encoding=enc,warn=FALSE),error=function(e)NULL)
  if(is.null(lines)||length(lines)<2)next
  x<-tryCatch(read.delim(textConnection(lines),sep="\t",header=TRUE,quote="",fill=TRUE,comment.char="",stringsAsFactors=FALSE,check.names=FALSE,na.strings=c("","NA","N/A")),error=function(e)NULL)
  if(!is.null(x)&&nrow(x)>0)return(x)
 }
 stop("Cannot read: ",p)
}
article<-read_tsv(file.path(project_dir,"figure5_article_data.txt"))
pre<-article|>filter(preprint_status=="Yes")
num<-function(x)suppressWarnings(as.numeric(x))
article<-article|>mutate(publication_year=num(publication_year),lag_online_mean_days=num(lag_online_mean_days))
pre<-pre|>mutate(publication_year=num(publication_year),across(c(preprint_to_submission_days,preprint_to_acceptance_days,preprint_to_online_days,preprint_strict_gllm_count,final_strict_gllm_count,preprint_final_jaccard,preprint_models_retained,final_models_added,preprint_models_removed,model_turnover_count,review_delay_days,production_delay_days),num))
pal<-c("#6F4C9F","#D56C9C","#7B8CCB","#B68ACD","#F59B5E","#F6D55C","#9E9E9E","#338333")
font_family<-"Arial"
theme_journal<-function(base_size=13)theme_classic(base_size=base_size,base_family=font_family)+theme(
 text=element_text(colour="#222222"),plot.title=element_text(face="bold",size=base_size+2),
 plot.subtitle=element_text(colour="#555555",margin=margin(b=9)),plot.caption=element_text(colour="#555555",size=base_size-2,hjust=0,margin=margin(t=9)),
 axis.title=element_text(face="bold"),legend.title=element_text(face="bold"),legend.position="top",
 panel.grid.major.y=element_line(colour="#E8E8E8",linewidth=.35),panel.grid.minor=element_blank(),
 plot.margin=margin(12,18,12,12))
fmt_p<-function(p)ifelse(is.na(p),"P unavailable",ifelse(p<.001,"P < 0.001",paste0("P = ",formatC(p,format="f",digits=3))))
write_tsv<-function(x,p)write.table(x,p,sep="\t",row.names=FALSE,col.names=TRUE,quote=FALSE,fileEncoding="UTF-8")
save_panel<-function(p,stem,w=10.5,h=7.2){
 saveRDS(p,file.path(script_dir,paste0(stem,".plot.rds")))
 ggsave(file.path(script_dir,paste0(stem,".pdf")),p,device=grDevices::cairo_pdf,width=w,height=h,units="in",bg="white")
 ggsave(file.path(script_dir,paste0(stem,".png")),p,device="png",dpi=600,width=w,height=h,units="in",bg="white")
}

stage_levels<-c("Before submission","During peer review","During production","After online publication","Milestone dates incomplete","Other/uncertain")
d<-pre|>count(preprint_stage,name="n")|>mutate(pct=n/sum(n),preprint_stage=factor(preprint_stage,levels=stage_levels))|>arrange(preprint_stage)
d<-filter(d,!is.na(preprint_stage),n>0)
d$preprint_stage<-droplevels(d$preprint_stage)
p<-ggplot(d,aes(pct,preprint_stage))+geom_segment(aes(x=0,xend=pct,yend=preprint_stage),linewidth=1.2,colour="#D9D2E9")+
 geom_point(aes(size=n,fill=preprint_stage),shape=21,stroke=1,colour="#333333")+
 geom_text(aes(label=paste0(n," (",percent(pct,accuracy=.1),")")),hjust=0,nudge_x=.030,size=4,family=font_family)+
 scale_fill_manual(values=setNames(pal[seq_len(nrow(d))],levels(d$preprint_stage)),guide="none")+
 scale_size_continuous(range=c(6,13),guide="none")+scale_x_continuous(labels=percent_format(accuracy=1),limits=c(0,max(d$pct)*1.38))+
 labs(title="When preprints were posted",subtitle="Position of the first preprint date in the editorial timeline",x="Share of preprint articles",y=NULL,
 caption=paste0("n = ",sum(d$n)," articles with a recorded preprint date; categories use exact submission, acceptance and online-publication dates."))+
 theme_journal()+theme(panel.grid.major.y=element_blank(),axis.text.y=element_text(face="bold"))
write_tsv(d,file.path(script_dir,"fig 5b analysis data used.txt"));writeLines(paste0("Counts sum to ",sum(d$n),"."),file.path(script_dir,"fig 5b statistical results.txt"))
save_panel(p,"Figure 5 B Timing of preprint posting")
