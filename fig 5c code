write_tsv(gpt,file.path(script_dir,"fig 4c analysis data used.txt"));write_tsv(summary_dat,file.path(script_dir,"fig 4c category summary.txt"));writeLines(c("Statistical unit: one unique article-model occurrence mapped in ChatGPT_successor_map.txt",paste0("Total mapped occurrences: ",nrow(gpt)),paste0("Unique articles: ",n_distinct(gpt$article_no)),"Successor rule: same developer and model track, with the earliest listed stronger successor date used for milestone classification.","Records lacking submission or acceptance dates are labelled indeterminate when a successor existed by online publication."),file.path(script_dir,"fig 4c statistical results.txt"))
